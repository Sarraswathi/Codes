class Student{
    String name;
    Student(String name){
        this.name=name;
    }
}

class Teacher{

    void teach(Student s){
        System.out.println("Teaching "+ s.name);
    }

}
public class AssociationDemo {
    public static void main(String[] args) {

        Student s=new Student("Students");
        Teacher t=new Teacher();

        t.teach(s);
    }
}
